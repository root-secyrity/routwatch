# Maintainer: root-secyrity <root-secyrity@users.noreply.github.com>
#
# Release package: builds the exact tarball GitHub serves for the tag, not
# whatever `main` happens to be. Use this to reproduce the .pkg.tar.zst that is
# attached to a GitHub release.
#
#   cd packaging && cp PKGBUILD.release PKGBUILD && makepkg -si
#
# When a new tag is cut, bump pkgver and refresh the checksum:
#   updpkgsums
#
# 0.5.0: pkgver is bumped and the digest below still names the v0.4.6 archive
# on purpose: the v0.5.0 archive cannot be hashed before the tag exists. The
# checksum PR after the tag pins the right one.
#
# 0.4.6: the checksum is pinned to the v0.4.6 tag archive, confirmed from two
# endpoints (github.com archive and codeload, byte-identical) before the package
# was built.
#
# 0.4.5: the checksum is pinned to the v0.4.5 tag archive, confirmed from two
# endpoints (github.com archive and codeload, byte-identical) before the package
# was built.
#
# 0.4.4: the checksum is pinned to the v0.4.4 tag archive, confirmed from two
# endpoints (github.com archive and codeload) before the package was built.
#
# 0.4.3: the same rule held then, with the digest of the 0.4.2 tarball.
#
# For a package that always tracks the latest commit use PKGBUILD (the
# routwatch-git recipe) instead.

pkgname=routwatch
pkgver=0.5.0
pkgrel=1
pkgdesc="Huawei LTE/5G CPE manager in the terminal - live signal, traffic, clients, bands and DNS"
arch=('x86_64' 'aarch64')
url="https://github.com/root-secyrity/routwatch"
license=('MIT')
depends=('glibc' 'libgcc')
makedepends=('rust' 'cargo')
provides=('routwatch')
conflicts=('routwatch-git')
options=('!lto' '!strip')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('fa2a344fb7d9fb965a4d5f91ad2290a0b2329832c03ef922075302e1615f3c0d')

build() {
	cd "$pkgname-$pkgver"
	export CARGO_TARGET_DIR=target
	export RUSTUP_TOOLCHAIN=stable
	cargo build --frozen --release
}

check() {
	cd "$pkgname-$pkgver"
	export CARGO_TARGET_DIR=target
	export RUSTUP_TOOLCHAIN=stable
	cargo test --frozen --release
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
	install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
