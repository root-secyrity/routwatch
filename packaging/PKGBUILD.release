# Maintainer: root-secyrity <root-secyrity@users.noreply.github.com>
#
# Release package: builds the exact tarball GitHub serves for the tag, not
# whatever `main` happens to be. Use this to reproduce the .pkg.tar.zst that is
# attached to a GitHub release.
#
#   cd packaging && cp PKGBUILD.release PKGBUILD && makepkg -si
#
# When a new tag is cut, bump pkgver and refresh the checksum:
#   updpkgsums
#
# 0.10.0: the checksum is refreshed from the v0.10.0 tag archive after the tag is
# cut, as 0.9.3 was.
#
# 0.9.3: the checksum is refreshed from the v0.9.3 tag archive after the tag is
# cut, as 0.9.2 was.
#
# 0.9.2: the checksum is refreshed from the v0.9.2 tag archive after the tag is
# cut; 0.9.1 shipped the 0.9.1 archive unchanged.
#
# 0.9.0: the checksum is pinned to the v0.9.0 tag archive, confirmed from two
# endpoints (github.com archive and codeload, byte-identical) before the package
# was built.
#
# 0.8.0: the checksum is pinned to the v0.8.0 tag archive, confirmed from two
# endpoints (github.com archive and codeload, byte-identical) before the package
# was built.
#
# 0.7.0: the checksum is pinned to the v0.7.0 tag archive, confirmed from two
# endpoints (github.com archive and codeload, byte-identical) before the package
# was built.
#
# 0.6.0: the checksum is pinned to the v0.6.0 tag archive, confirmed from two
# endpoints (github.com archive and codeload, byte-identical) before the package
# was built.
#
# 0.5.1: the checksum is pinned to the v0.5.1 tag archive, confirmed from two
# endpoints (github.com archive and codeload, byte-identical) before the package
# was built.
#
# 0.4.6: the checksum is pinned to the v0.4.6 tag archive, confirmed from two
# endpoints (github.com archive and codeload, byte-identical) before the package
# was built.
#
# 0.4.5: the checksum is pinned to the v0.4.5 tag archive, confirmed from two
# endpoints (github.com archive and codeload, byte-identical) before the package
# was built.
#
# 0.4.4: the checksum is pinned to the v0.4.4 tag archive, confirmed from two
# endpoints (github.com archive and codeload) before the package was built.
#
# 0.4.3: the same rule held then, with the digest of the 0.4.2 tarball.
#
# For a package that always tracks the latest commit use PKGBUILD (the
# routwatch-git recipe) instead.

pkgname=routwatch
pkgver=0.10.3
pkgrel=1
pkgdesc="Huawei LTE/5G CPE manager in the terminal - live signal, traffic, clients, bands and DNS"
arch=('x86_64' 'aarch64')
url="https://github.com/root-secyrity/routwatch"
license=('MIT')
depends=('glibc' 'libgcc')
makedepends=('rust' 'cargo')
provides=('routwatch')
conflicts=('routwatch-git')
options=('!lto' '!strip')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('528a79d95bef2b924ec05145e341dde420e2aa125bf48182202884d1adaf6ecc')

build() {
	cd "$pkgname-$pkgver"
	export CARGO_TARGET_DIR=target
	export RUSTUP_TOOLCHAIN=stable
	cargo build --frozen --release
}

check() {
	cd "$pkgname-$pkgver"
	export CARGO_TARGET_DIR=target
	export RUSTUP_TOOLCHAIN=stable
	cargo test --frozen --release
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
	install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
