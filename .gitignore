# rust build output
/target
*.rwr

# a real config never belongs in the repo
config.toml

# makepkg artefacts (the PKGBUILD lives in packaging/)
/packaging/src/
/packaging/pkg/
/packaging/*.pkg.tar.*
/packaging/*.tar.gz
/packaging/*.tar.zst

# internal, not published
/DOCK/
# The live test files and the CLI tests are the exception, and they are
# published: a guard that lives on one machine guards nothing. This firmware has
# no push channel and no second session to measure against, so a reader without
# the device can still compile and run them. The CLI fixture is synthetic for the
# same reason: it stays and the device capture does not.
/tests/*
!/tests/cli.rs
!/tests/common/
!/tests/common/mod.rs
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/snapshot_fixed.json
!/tests/capabilities.rs
!/tests/config_snapshot.rs
!/tests/live_guards.rs
!/tests/obs_log.rs
!/tests/incidents.rs
!/tests/privacy_drift.rs
!/tests/live_probe.rs
!/tests/tier_*.rs
!/tests/advisor.rs
!/tests/antenna_worth.rs

# static binaries from packaging/musl-build.sh
/dist/

# `routwatch dump` writes here by default
routwatch-dump*.json
# prowl-agent: derived state
.prowl/index.db*
.prowl/cache/
.prowl/logs/
.prowl/editor/
.prowl/setup-applies.json
.prowl-setup.lock
# /prowl-agent: derived state

# prowl: the hand-edited project config is tracked, everything else in .prowl is derived
.prowl/*
!.prowl/config.toml
