# rust build output
/target
*.rwr

# a real config never belongs in the repo
config.toml

# makepkg artefacts (the PKGBUILD lives in packaging/)
/packaging/src/
/packaging/pkg/
/packaging/*.pkg.tar.*
/packaging/*.tar.gz
/packaging/*.tar.zst

# internal, not published
/DOCK/
/tests/

# static binaries from packaging/musl-build.sh
/dist/

# `routwatch dump` writes here by default
routwatch-dump*.json
# prowl-agent: derived state
.prowl/index.db*
.prowl/cache/
.prowl/logs/
.prowl/editor/
.prowl/setup-applies.json
.prowl-setup.lock
# /prowl-agent: derived state

# prowl: the hand-edited project config is tracked, everything else in .prowl is derived
.prowl/*
!.prowl/config.toml
